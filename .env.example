# Fabrikanın SQL Server'ı (sadece okunur). Geliştirmede Docker'daki simüle SQL Server.
# Canlıda sa değil, sadece SELECT izni olan bir kullanıcı (docs/kurulum.md)
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
# Geliştirme: Docker'daki SQL Server'ın sa şifresi. Canlı: MSSQL_PASSWORD=<salt-okur kullanıcının şifresi>
MSSQL_SA_PASSWORD=Tm50!Assembly2026
MSSQL_DB=TM50Line

# Collector: SQL Server'dan veri çekme aralığı (dakika, 3–5). Sadece ilk kurulumda kullanılır;
# sonra Admin → Entegrasyon ekranından değişir.
COLLECT_INTERVAL_MIN=3

# Uygulama veritabanı (SQLite)
SQLITE_PATH=data/tm50.db

# API ve arayüz (npm start, derlenmiş arayüzü de aynı adresten sunar)
API_PORT=3001
# Ağdaki diğer bilgisayarlardan erişim için canlıda 0.0.0.0
API_HOST=127.0.0.1
# HTTPS: sertifika yolları verilirse API doğrudan HTTPS sunar (yoksa önüne reverse proxy konur)
HTTPS_KEY=
HTTPS_CERT=
# HTTPS reverse proxy'de (IIS / nginx) sonlanıyorsa 1: oturum çerezi yalnızca HTTPS'te gönderilir
COOKIE_SECURE=0
# İlk açılışta kullanıcılara atanan PIN / şifre (sadece geliştirme; canlıda değiştirin)
DEFAULT_PIN=1234
