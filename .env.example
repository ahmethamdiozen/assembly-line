# Fabrikanın SQL Server'ı (sadece okunur). Geliştirmede Docker'daki simüle SQL Server.
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_SA_PASSWORD=Tm50!Assembly2026
MSSQL_DB=TM50Line

# Collector: SQL Server'dan veri çekme aralığı (dakika, 3–5)
COLLECT_INTERVAL_MIN=3

# Uygulama veritabanı (SQLite)
SQLITE_PATH=data/tm50.db

# API
API_PORT=3001
API_HOST=127.0.0.1
# HTTPS: sertifika yolları verilirse API doğrudan HTTPS sunar (yoksa önüne reverse proxy konur)
HTTPS_KEY=
HTTPS_CERT=
# İlk açılışta kullanıcılara atanan PIN / şifre (sadece geliştirme; canlıda değiştirin)
DEFAULT_PIN=1234
