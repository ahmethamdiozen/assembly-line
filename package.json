{
  "name": "tm50-assembly-line",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "sim": "tsx --tsconfig server/tsconfig.json server/simulator/index.ts",
    "sim:reset": "tsx --tsconfig server/tsconfig.json server/simulator/index.ts --reset",
    "server": "tsx --tsconfig server/tsconfig.json server/index.ts",
    "build:server": "vite build --ssr server/index.ts --outDir dist-server --emptyOutDir && vite build --ssr server/db/backup.ts --outDir dist-server --no-emptyOutDir",
    "start": "node dist-server/index.js",
    "stack": "concurrently -k -n sim,server,web -c yellow,cyan,green \"npm:sim\" \"npm:server\" \"npm:dev\"",
    "db:backup": "tsx --tsconfig server/tsconfig.json server/db/backup.ts",
    "db:restore": "tsx --tsconfig server/tsconfig.json server/db/backup.ts --restore",
    "dev:demo": "vite --mode demo",
    "build:demo": "tsc -b && vite build --mode demo",
    "preview:demo": "vite preview --mode demo",
    "docs:matrix": "node scripts/izlenebilirlik.mjs",
    "test:kabul": "npm run build:demo && node scripts/kabul-testi.mjs"
  },
  "dependencies": {
    "@ag-grid-community/locale": "^36.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "fastify": "^5.12.5",
    "lucide-react": "^1.48.0",
    "mssql": "^12.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}
